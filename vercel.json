{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://growthintel2.onrender.com/api/v1/:path*"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/membership",
      "destination": "/membership.html"
    },
    {
      "source": "/admin-memberships",
      "destination": "/admin-memberships.html"
    },
    {
      "source": "/history",
      "destination": "/history.html"
    },
    {
      "source": "/watchlist",
      "destination": "/watchlist.html"
    }
  ]
}
